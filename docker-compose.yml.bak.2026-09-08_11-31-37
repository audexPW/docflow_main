# DocFlow — единый compose: БД + бэкенд + фронт (веб) + опц. локальный AI-стек.
# Разворачивается одной командой ./deploy.sh
#
# Сервис бэкенда назван РОВНО docflow-backend — именно это имя ждёт
# nginx фронтенда (docflow-frontend/nginx.conf: proxy_pass docflow-backend:8080).
#
# Локальный AI (surya-ocr + llm) вынесен в профиль "ai": по умолчанию НЕ
# поднимается, чтобы базовый стек был лёгким. Включается одним переключателем
# в .env: COMPOSE_PROFILES=ai  (плюс OCR_ENGINE / LLM_ENABLED — см. .env).

services:
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-docflow}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-docflow}
      POSTGRES_DB: ${POSTGRES_DB:-docflow}
    volumes:
      - docflow_pg:/var/lib/postgresql/data
    mem_limit: 1g
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-docflow}"]
      interval: 5s
      timeout: 5s
      retries: 20

  docflow-backend:
    build: ./docflow
    restart: unless-stopped
    env_file: .env
    depends_on:
      postgres:
        condition: service_healthy
    volumes:
      - docflow_files:/var/lib/docflow
      # Реестр типов документов и их соответствия объектам 1С. Правится на
      # хосте, применяется рестартом бэкенда — без пересборки образа.
      - ./doctypes.json:/etc/docflow/doctypes.json:ro
    # Хост у заказчика тесный по памяти: без лимитов OOM killer выберет жертву
    # сам, и это будет postgres. Значения рассчитаны на 8 ГБ.
    mem_limit: 4g
    healthcheck:
      test: ["CMD", "/app/docflow", "-healthcheck"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    # Порт наружу не публикуем: доступ к API идёт через фронтовый nginx (/api).
    # Для отладки можно раскомментировать:
    # ports:
    #   - "8080:8080"

  frontend:
    build: ./docflow-frontend
    restart: unless-stopped
    depends_on:
      - docflow-backend
    # Порт наружу публикуется только если HTTPS выключен. При заданном DOMAIN
    # весь трафик принимает caddy, а фронт остаётся во внутренней сети.
    expose:
      - "80"
    mem_limit: 256m

  # --- HTTPS (профиль "tls") --------------------------------------------------
  # Включается автоматически, когда в .env задан DOMAIN: deploy.sh добавляет
  # профиль tls. Caddy сам получает и продлевает сертификат Let's Encrypt,
  # редиректит http→https и проксирует всё на фронт.
  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    profiles: ["tls"]
    depends_on:
      - frontend
    environment:
      DOMAIN: ${DOMAIN}
      ACME_EMAIL: ${ACME_EMAIL:-}
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    mem_limit: 256m

  # --- Доступ по HTTP (профиль "plain") ---------------------------------------
  # Для стенда без домена. deploy.sh включает этот профиль, когда DOMAIN пуст,
  # и громко предупреждает, что так в бой выпускать нельзя.
  frontend-http:
    image: alpine/socat:latest
    restart: unless-stopped
    profiles: ["plain"]
    depends_on:
      - frontend
    command: TCP-LISTEN:80,fork,reuseaddr TCP:frontend:80
    ports:
      - "${HTTP_PORT:-80}:80"
    mem_limit: 64m

  # Surya оставлена как альтернативный тяжёлый движок (OCR_ENGINE=surya).
  # По умолчанию профилем ai не поднимается — профиль "ai-surya".
  surya-ocr:
    build:
      context: ./surya-ocr
      args:
        # WARMUP=1 (по умолчанию) вшивает веса моделей в образ — контейнер
        # работает офлайн. На офлайн-машине сборки: WARMUP=0.
        WARMUP: ${SURYA_WARMUP:-1}
    restart: unless-stopped
    profiles: ["ai-surya"]
    environment:
      OCR_THREADS: ${SURYA_THREADS:-4}
      RECOGNITION_BATCH_SIZE: ${SURYA_REC_BATCH:-16}
      DETECTOR_BATCH_SIZE: ${SURYA_DET_BATCH:-4}
      # Порог склейки боксов в одну строку (доля от высоты строки).
      # Чем меньше, тем уже ряд: ячейки таблицы перестают расползаться
      # по соседним строкам из-за крупных заголовков на странице.
      SURYA_ROW_FACTOR: ${SURYA_ROW_FACTOR:-0.35}
      # Зазор между колонками в символах — при нём ставится « | ».
      SURYA_COL_GAP: ${SURYA_COL_GAP:-4}
      # Пустая строка между блоками текста.
      SURYA_GAP_FACTOR: ${SURYA_GAP_FACTOR:-1.2}
    expose:
      - "8422"
    mem_limit: ${SURYA_MEM_LIMIT:-4g}

  llm:
    image: ghcr.io/ggml-org/llama.cpp:server
    restart: unless-stopped
    profiles: ["ai"]
    command: >
      -m /models/${LLM_GGUF:-qwen2.5-7b-instruct-q4_k_m.gguf}
      --host 0.0.0.0 --port 8081
      -c ${LLM_CTX:-8192}
      -t ${LLM_THREADS:-4}
    volumes:
      - ./models:/models
    expose:
      - "8081"
    mem_limit: ${LLM_MEM_LIMIT:-6g}

volumes:
  docflow_pg:
  docflow_files:
  caddy_data:
  caddy_config:
