# Адрес бэкенда.
#
# ВЕБ: оставьте пустым — запросы пойдут на тот же хост (/api/...),
#      а nginx перенаправит их на бэкенд (см. nginx.conf).
#
# МОБИЛЬНОЕ ПРИЛОЖЕНИЕ: укажите полный адрес сервера заказчика,
#      т.к. приложение открывается с file:// и относительные пути не сработают.
#      Пример: VITE_API_BASE_URL=https://docs.client.ru
VITE_API_BASE_URL=
