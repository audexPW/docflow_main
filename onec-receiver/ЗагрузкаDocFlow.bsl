// Приёмник выгрузки DocFlow для «Моя бухгалтерия 8».
//
// ЭТО КАРКАС, А НЕ ГОТОВАЯ ОБРАБОТКА. Разбор XML, обход папки, идемпотентность и
// диспетчеризация по <Target> написаны полностью и от конфигурации не зависят.
// Заполнение реквизитов конкретных документов — процедура ЗаполнитьДокумент —
// оставлено заглушкой: имена объектов и их реквизиты берутся из базы заказчика
// (см. ONEC-INTEGRATION.md, раздел «Что уже прочитано в базе»).
//
// Режим работы — ручной: кнопка «Загрузить документы» на форме обработки.
// Регламентное задание в файловой базе живёт только пока открыта 1С, поэтому
// автоматику не используем.
//
// Размещение: внешняя обработка на время отладки, затем — обработка в расширении
// конфигурации (типовая на поддержке, править её нельзя).

#Область ПрограммныйИнтерфейс

// ЗагрузитьИзПапки — точка входа кнопки.
//
// Параметры:
//   ПапкаОбмена  - Строка - сетевой путь к папке, куда DocFlow кладёт XML.
//   ПапкаАрхива  - Строка - куда переносить обработанные файлы.
//
// Возвращаемое значение:
//   Структура - Загружено, Пропущено, Ошибок, Протокол (Массив строк).
//
Функция ЗагрузитьИзПапки(ПапкаОбмена, ПапкаАрхива) Экспорт

	Результат = Новый Структура("Загружено, Пропущено, Ошибок, Протокол", 0, 0, 0, Новый Массив);

	Файлы = НайтиФайлы(ПапкаОбмена, "*.xml", Ложь);
	Для Каждого Файл Из Файлы Цикл

		// Файлы, имя которых начинается с точки, DocFlow ещё дописывает.
		Если Лев(Файл.Имя, 1) = "." Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Данные = ПрочитатьВыгрузку(Файл.ПолноеИмя);
		Исключение
			Результат.Ошибок = Результат.Ошибок + 1;
			Результат.Протокол.Добавить(Файл.Имя + ": не разобран XML — " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Попытка
			Статус = ОбработатьВыгрузку(Данные);
		Исключение
			Результат.Ошибок = Результат.Ошибок + 1;
			Результат.Протокол.Добавить(Файл.Имя + ": " + ОписаниеОшибки());
			ОтправитьСтатус(Данные.SourceId, "error", "", ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Если Статус = "пропущен" Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
		Иначе
			Результат.Загружено = Результат.Загружено + 1;
		КонецЕсли;
		Результат.Протокол.Добавить(Файл.Имя + ": " + Статус);

		ПеренестиВАрхив(Файл, ПапкаАрхива);

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область РазборXML

// ПрочитатьВыгрузку разбирает файл в структуру. Формат стабилен и описан в
// ONEC-INTEGRATION.md; здесь он читается целиком, включая табличную часть.
Функция ПрочитатьВыгрузку(ПутьКФайлу)

	Данные = Новый Структура;
	Данные.Вставить("SourceId", "");
	Данные.Вставить("Вид", "create");          // create | partial | update
	Данные.Вставить("Неполный", Ложь);
	Данные.Вставить("Тип", "");                 // код типа DocFlow
	Данные.Вставить("ТипНаименование", "");
	Данные.Вставить("ОбъектПриемник", "");      // Target/@object
	Данные.Вставить("ВидПриемника", "");        // Target/@kind
	Данные.Вставить("Поля", Новый Соответствие);
	Данные.Вставить("Контрагент", Новый Соответствие);
	Данные.Вставить("Строки", Новый Массив);
	Данные.Вставить("НеЗаполнено", Новый Массив);

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ПутьКФайлу);

	ТекущийУзел = "";
	Путь = Новый Массив;

	Пока Чтение.Прочитать() Цикл

		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

			Путь.Добавить(Чтение.Имя);
			ТекущийУзел = Чтение.Имя;

			Если Чтение.Имя = "Document" Тогда
				Пока Чтение.ПрочитатьАтрибут() Цикл
					Если Чтение.Имя = "kind" Тогда
						Данные.Вид = Чтение.Значение;
					ИначеЕсли Чтение.Имя = "incomplete" Тогда
						Данные.Неполный = (НРег(Чтение.Значение) = "true");
					КонецЕсли;
				КонецЦикла;

			ИначеЕсли Чтение.Имя = "Target" Тогда
				Пока Чтение.ПрочитатьАтрибут() Цикл
					Если Чтение.Имя = "object" Тогда
						Данные.ОбъектПриемник = Чтение.Значение;
					ИначеЕсли Чтение.Имя = "kind" Тогда
						Данные.ВидПриемника = Чтение.Значение;
					КонецЕсли;
				КонецЦикла;

			ИначеЕсли Чтение.Имя = "Line" Тогда
				Данные.Строки.Добавить(Новый Соответствие);

			ИначеЕсли Чтение.Имя = "Field" И ВПути(Путь, "AdditionalFields") Тогда
				ИмяПоля = "";
				Пока Чтение.ПрочитатьАтрибут() Цикл
					Если Чтение.Имя = "name" Тогда
						ИмяПоля = Чтение.Значение;
					КонецЕсли;
				КонецЦикла;
				ТекущийУзел = "ДопПоле:" + ИмяПоля;
			КонецЕсли;

		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Тогда

			Значение = СокрЛП(Чтение.Значение);

			Если СтрНачинаетсяС(ТекущийУзел, "ДопПоле:") Тогда
				Данные.Поля.Вставить(Сред(ТекущийУзел, 9), Значение);

			ИначеЕсли ВПути(Путь, "Lines") И Данные.Строки.Количество() > 0 Тогда
				Данные.Строки[Данные.Строки.ВГраница()].Вставить(ТекущийУзел, Значение);

			ИначеЕсли ВПути(Путь, "Counterparty") Тогда
				Данные.Контрагент.Вставить(ТекущийУзел, Значение);

			ИначеЕсли ВПути(Путь, "MissingFields") Тогда
				Данные.НеЗаполнено.Добавить(Значение);

			ИначеЕсли ТекущийУзел = "SourceId" Тогда
				Данные.SourceId = Значение;
			ИначеЕсли ТекущийУзел = "Type" Тогда
				Данные.Тип = Значение;
			ИначеЕсли ТекущийУзел = "TypeTitle" Тогда
				Данные.ТипНаименование = Значение;
			Иначе
				Данные.Поля.Вставить(ТекущийУзел, Значение);
			КонецЕсли;

		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если Путь.Количество() > 0 Тогда
				Путь.Удалить(Путь.ВГраница());
			КонецЕсли;
			ТекущийУзел = "";
		КонецЕсли;

	КонецЦикла;

	Чтение.Закрыть();

	Если ПустаяСтрока(Данные.SourceId) Тогда
		ВызватьИсключение "в файле нет SourceId — сопоставлять документ не по чему";
	КонецЕсли;

	Возврат Данные;

КонецФункции

Функция ВПути(Путь, ИмяУзла)
	Для Каждого Узел Из Путь Цикл
		Если Узел = ИмяУзла Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

#КонецОбласти

#Область Загрузка

// ОбработатьВыгрузку выполняет upsert по SourceId.
//
// Правило простое: SourceId — единственный ключ сопоставления. Повторный файл с
// тем же SourceId обязан обновить документ, а не создать дубль; на этом держится
// досылка полей, которые сотрудник ввёл вручную уже после первой выгрузки.
Функция ОбработатьВыгрузку(Данные)

	Если ПустаяСтрока(Данные.ОбъектПриемник) Тогда
		ВызватьИсключение "в выгрузке нет <Target> — тип «" + Данные.Тип
			+ "» ещё не согласован, документ в базу не принимается";
	КонецЕсли;

	Ссылка = НайтиПоИдентификаторуDocFlow(Данные.ОбъектПриемник, Данные.SourceId);

	Если Данные.Вид = "update" И Не ЗначениеЗаполнено(Ссылка) Тогда
		// Досылка пришла раньше основной выгрузки — не создаём объект вслепую,
		// иначе получим документ без шапки. DocFlow пришлёт её повторно.
		Возврат "пропущен (досылка без основного документа)";
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		Если Данные.ВидПриемника = "catalog" Тогда
			Объект = ПолучитьОбъектСправочника(Данные.ОбъектПриемник, Ссылка);
		Иначе
			Объект = ПолучитьОбъектДокумента(Данные.ОбъектПриемник, Ссылка);
		КонецЕсли;

		ЗаполнитьДокумент(Объект, Данные);

		// Идентификатор DocFlow — дополнительный реквизит из расширения.
		Объект.ИдентификаторDocFlow = Данные.SourceId;

		Объект.Записать();

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;

	Если Данные.Неполный Тогда
		// Неполный документ не проводим: часть реквизитов ещё дошлётся, а
		// проведённый документ с неверной суммой опаснее непроведённого.
		ОтправитьСтатус(Данные.SourceId, "accepted", Строка(Объект.Ссылка),
			"не заполнено: " + СтрСоединить(Данные.НеЗаполнено, ", "));
		Возврат "загружен, требует проверки";
	КонецЕсли;

	ОтправитьСтатус(Данные.SourceId, "accepted", Строка(Объект.Ссылка), "");
	Возврат "загружен";

КонецФункции

// ЗаполнитьДокумент — правила заполнения по видам объектов базы заказчика.
// Имена реквизитов сверены по отчёту по конфигурации от 20.07.2026.
//
// Даты приходят строкой ДД.ММ.ГГГГ, суммы — с точкой как разделителем.
Процедура ЗаполнитьДокумент(Объект, Данные)

	Если Данные.ОбъектПриемник = "Документ.ПоступлениеТМЦ"
		Или Данные.ОбъектПриемник = "Документ.АктПриемкиТМЦПриход" Тогда
		ЗаполнитьПоступлениеТМЦ(Объект, Данные);

	ИначеЕсли Данные.ОбъектПриемник = "Документ.ПолучениеУслуг" Тогда
		ЗаполнитьПолучениеУслуг(Объект, Данные);

	ИначеЕсли Данные.ОбъектПриемник = "Документ.ЭСЧФВходящий" Тогда
		ЗаполнитьЭСЧФВходящий(Объект, Данные);

	Иначе
		ВызватьИсключение "ЗаполнитьДокумент: правила для «" + Данные.ОбъектПриемник
			+ "» ещё не заданы";
	КонецЕсли;

КонецПроцедуры

// Приход товара по ТТН-1 / ТН-2.
//
// Контрагент в этой конфигурации хранится НЕ отдельным реквизитом, а как
// субконто счёта кредита (СчетКредита + КСубконто1..3, тип «ЛюбаяСсылка»).
// Какой именно индекс субконто отведён под контрагента — зависит от настройки
// плана счетов заказчика, поэтому счёт и порядок субконто вынесены в константы
// расширения, а не зашиты здесь. Это последнее, что нужно подтвердить перед
// боевым запуском.
Процедура ЗаполнитьПоступлениеТМЦ(Объект, Данные)

	Объект.Дата = ДатаИзВыгрузки(Данные.Поля.Получить("Date"));
	Объект.Организация = НайтиОрганизацию(Данные.Поля.Получить("Organization"),
		Данные.Поля.Получить("OrganizationUNP"));

	Объект.НомерСопроводительногоДокумента = Данные.Поля.Получить("Number");
	Объект.ДатаНакладной = Объект.Дата;
	Объект.НаименованиеДокумента = Данные.ТипНаименование;

	Объект.Валюта = НайтиВалюту(Данные.Поля.Получить("Currency"));
	Объект.СуммаВсего = ЧислоИзВыгрузки(Данные.Поля.Получить("Total"));
	Объект.СуммаНДС = ЧислоИзВыгрузки(Данные.Поля.Получить("VATAmount"));

	Контрагент = НайтиИлиСоздатьКонтрагента(Данные);
	Объект.СчетКредита = Константы.DocFlowСчетРасчетовСПоставщиками.Получить();
	Объект.КСубконто1 = Контрагент;

	Объект.Номенклатура.Очистить();
	Для Каждого СтрокаВыгрузки Из Данные.Строки Цикл

		НоменклатураСсылка = НайтиНоменклатуру(СтрокаВыгрузки.Получить("Name"));
		Если Не ЗначениеЗаполнено(НоменклатураСсылка) Тогда
			// Молча создавать номенклатуру нельзя: справочник зарастёт дублями
			// с опечатками OCR. Строка пропускается, документ помечается на
			// проверку — привязку делает человек.
			Продолжить;
		КонецЕсли;

		Строка = Объект.Номенклатура.Добавить();
		Строка.ТМЦ = НоменклатураСсылка;
		Строка.Количество = ЧислоИзВыгрузки(СтрокаВыгрузки.Получить("Qty"));
		Строка.Цена = ЧислоИзВыгрузки(СтрокаВыгрузки.Получить("Price"));
		Строка.СуммаБезНДС = ЧислоИзВыгрузки(СтрокаВыгрузки.Получить("Amount"));
		Строка.СуммаВсего = Строка.СуммаБезНДС;
		Строка.СтавкаНДС = НайтиСтавкуНДС(СтрокаВыгрузки.Получить("VAT"));
		Строка.ЕдиницаИзмерения = НайтиЕдиницуИзмерения(СтрокаВыгрузки.Получить("Unit"));

	КонецЦикла;

	Объект.Комментарий = "Загружено из DocFlow, файл " + Данные.Поля.Получить("FileName");

КонецПроцедуры

// Акт выполненных работ / оказанных услуг. Табличная часть — Услуги, привязки к
// номенклатуре не требует, поэтому строки переносятся содержанием и суммами.
Процедура ЗаполнитьПолучениеУслуг(Объект, Данные)

	Объект.Дата = ДатаИзВыгрузки(Данные.Поля.Получить("Date"));
	Объект.Организация = НайтиОрганизацию(Данные.Поля.Получить("Organization"),
		Данные.Поля.Получить("OrganizationUNP"));
	Объект.НаименованиеДокумента = Данные.ТипНаименование;

	Объект.Валюта = НайтиВалюту(Данные.Поля.Получить("Currency"));
	Объект.СуммаВсего = ЧислоИзВыгрузки(Данные.Поля.Получить("Total"));
	Объект.СуммаНДС = ЧислоИзВыгрузки(Данные.Поля.Получить("VATAmount"));
	Объект.СуммаБезНДС = Объект.СуммаВсего - Объект.СуммаНДС;

	Контрагент = НайтиИлиСоздатьКонтрагента(Данные);
	Объект.СчетКредита = Константы.DocFlowСчетРасчетовСПоставщиками.Получить();
	Объект.КСубконто1 = Контрагент;

	Объект.Услуги.Очистить();
	Для Каждого СтрокаВыгрузки Из Данные.Строки Цикл
		Строка = Объект.Услуги.Добавить();
		Строка.Содержание = СтрокаВыгрузки.Получить("Name");
		Строка.СуммаБезНДС = ЧислоИзВыгрузки(СтрокаВыгрузки.Получить("Amount"));
		Строка.СуммаВсего = Строка.СуммаБезНДС;
		Строка.СтавкаНДС = НайтиСтавкуНДС(СтрокаВыгрузки.Получить("VAT"));
	КонецЦикла;

	Если Объект.Услуги.Количество() = 0 Тогда
		// Услуга одной строкой: в акте часто нет таблицы, только итог.
		Строка = Объект.Услуги.Добавить();
		Строка.Содержание = "По документу " + Данные.Поля.Получить("Number");
		Строка.СуммаБезНДС = Объект.СуммаБезНДС;
		Строка.СуммаНДС = Объект.СуммаНДС;
		Строка.СуммаВсего = Объект.СуммаВсего;
	КонецЕсли;

	Объект.Комментарий = "Загружено из DocFlow, файл " + Данные.Поля.Получить("FileName");

КонецПроцедуры

// ЭСЧФ поставщика — единственный из трёх видов, где реквизиты поставщика лежат
// прямо в шапке, без субконто. Поэтому он заполняется точнее всего.
Процедура ЗаполнитьЭСЧФВходящий(Объект, Данные)

	Объект.Дата = ДатаИзВыгрузки(Данные.Поля.Получить("Date"));
	Объект.Организация = НайтиОрганизацию(Данные.Поля.Получить("Organization"),
		Данные.Поля.Получить("OrganizationUNP"));

	Объект.Контрагент = НайтиИлиСоздатьКонтрагента(Данные);
	Объект.УНППоставщика = Данные.Контрагент.Получить("UNP");
	Объект.НаименованиеПоставщика = Данные.Контрагент.Получить("Name");
	Объект.УНППолучателя = Данные.Поля.Получить("OrganizationUNP");

	Объект.НомерДокументаПоставки = Данные.Поля.Получить("Number");
	Объект.ДатаДокументаПоставки = Объект.Дата;
	Объект.ДатаОперации = Объект.Дата;
	Объект.НазваниеДокументаПоставки = Данные.ТипНаименование;

	Объект.СуммаВсего = ЧислоИзВыгрузки(Данные.Поля.Получить("Total"));
	Объект.СуммаНДС = ЧислоИзВыгрузки(Данные.Поля.Получить("VATAmount"));

	Объект.Комментарий = "Загружено из DocFlow, файл " + Данные.Поля.Получить("FileName");

КонецПроцедуры

#КонецОбласти

#Область ПоискСправочников

// НайтиИлиСоздатьКонтрагента ищет по УНП — это единственный надёжный ключ.
// По наименованию не ищем: «ООО Ромашка» и «ООО \"Ромашка\"» после OCR — разные
// строки, и поиск по имени плодит дубли вместо связывания.
Функция НайтиИлиСоздатьКонтрагента(Данные)

	УНП = СокрЛП(Данные.Контрагент.Получить("UNP"));
	Наименование = СокрЛП(Данные.Контрагент.Получить("Name"));

	Если Не ПустаяСтрока(УНП) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1 К.Ссылка КАК Ссылка
			|ИЗ Справочник.Контрагенты КАК К
			|ГДЕ К.УНП = &УНП И НЕ К.ПометкаУдаления";
		Запрос.УстановитьПараметр("УНП", УНП);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(УНП) Или ПустаяСтрока(Наименование) Тогда
		ВызватьИсключение "контрагент не определён: нет УНП или наименования";
	КонецЕсли;

	Новый_ = Справочники.Контрагенты.СоздатьЭлемент();
	Новый_.Наименование = Лев(Наименование, 100);
	Новый_.ПолноеНаименование = Наименование;
	Новый_.УНП = УНП;
	Новый_.ФлагПоставщик = Истина;
	Новый_.РезидентРБ = Истина;
	Новый_.Записать();

	Возврат Новый_.Ссылка;

КонецФункции

Функция НайтиОрганизацию(Наименование, УНП)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 О.Ссылка КАК Ссылка
		|ИЗ Справочник.Организации КАК О
		|ГДЕ НЕ О.ПометкаУдаления И (О.УНП = &УНП ИЛИ О.Наименование = &Наименование)";
	Запрос.УстановитьПараметр("УНП", СокрЛП(УНП));
	Запрос.УстановитьПараметр("Наименование", СокрЛП(Наименование));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	// Организацию не создаём никогда — своих фирм конечное число, и лишняя
	// запись в этом справочнике ломает отчётность.
	Возврат Константы.DocFlowОрганизацияПоУмолчанию.Получить();

КонецФункции

Функция НайтиНоменклатуру(Наименование)
	Если ПустаяСтрока(Наименование) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Номенклатура.НайтиПоНаименованию(СокрЛП(Наименование), Истина);
КонецФункции

Функция НайтиВалюту(Код)
	Если ПустаяСтрока(Код) Тогда
		Возврат Константы.DocFlowВалютаПоУмолчанию.Получить();
	КонецЕсли;
	Ссылка = Справочники.Валюты.НайтиПоКоду(СокрЛП(Код));
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Возврат Константы.DocFlowВалютаПоУмолчанию.Получить();
КонецФункции

Функция НайтиСтавкуНДС(Значение)
	Если ПустаяСтрока(Значение) Тогда
		Возврат Справочники.СтавкиНДС.ПустаяСсылка();
	КонецЕсли;
	// В выгрузке ставка приходит как «20%» либо как сумма — второе нам не подходит.
	Очищенное = СтрЗаменить(СокрЛП(Значение), "%", "");
	Возврат Справочники.СтавкиНДС.НайтиПоНаименованию(Очищенное + "%", Истина);
КонецФункции

Функция НайтиЕдиницуИзмерения(Обозначение)
	Если ПустаяСтрока(Обозначение) Тогда
		Возврат Справочники.ОКЕИ.ПустаяСсылка();
	КонецЕсли;
	Возврат Справочники.ОКЕИ.НайтиПоНаименованию(СокрЛП(Обозначение), Истина);
КонецФункции

#КонецОбласти

#Область Преобразования

Функция ДатаИзВыгрузки(Значение)
	Строка_ = СокрЛП(Значение);
	Если СтрДлина(Строка_) <> 10 Тогда
		Возврат ТекущаяДата();
	КонецЕсли;
	// ДД.ММ.ГГГГ → ГГГГММДД
	Возврат Дата(Сред(Строка_, 7, 4) + Сред(Строка_, 4, 2) + Лев(Строка_, 2));
КонецФункции

Функция ЧислоИзВыгрузки(Значение)
	Строка_ = СтрЗаменить(СокрЛП(Значение), " ", "");
	Строка_ = СтрЗаменить(Строка_, ",", ".");
	Если ПустаяСтрока(Строка_) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Строка_);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедуры

Функция НайтиПоИдентификаторуDocFlow(ИмяОбъекта, SourceId)

	Части = СтрРазделить(ИмяОбъекта, ".");
	Если Части.Количество() <> 2 Тогда
		ВызватьИсключение "некорректное имя объекта: " + ИмяОбъекта;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка
		|ИЗ " + ИмяОбъекта + " КАК Т
		|ГДЕ Т.ИдентификаторDocFlow = &SourceId";
	Запрос.УстановитьПараметр("SourceId", SourceId);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьОбъектДокумента(ИмяОбъекта, Ссылка)
	ИмяВида = Сред(ИмяОбъекта, СтрНайти(ИмяОбъекта, ".") + 1);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Возврат Документы[ИмяВида].СоздатьДокумент();
КонецФункции

Функция ПолучитьОбъектСправочника(ИмяОбъекта, Ссылка)
	ИмяВида = Сред(ИмяОбъекта, СтрНайти(ИмяОбъекта, ".") + 1);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Возврат Справочники[ИмяВида].СоздатьЭлемент();
КонецФункции

Процедура ПеренестиВАрхив(Файл, ПапкаАрхива)
	Если Не ЗначениеЗаполнено(ПапкаАрхива) Тогда
		Возврат;
	КонецЕсли;
	СоздатьКаталог(ПапкаАрхива);
	ПереместитьФайл(Файл.ПолноеИмя, ПапкаАрхива + "\" + Файл.Имя);
КонецПроцедуры

#КонецОбласти

#Область ОбратныйСтатус

// ОтправитьСтатус возвращает результат обработки в DocFlow, иначе пользователь
// видит только «передано в обмен» и не знает, дошёл документ до учёта или нет.
//
// Адрес и токен вынести в константы расширения, а не хардкодить.
Процедура ОтправитьСтатус(SourceId, Статус, Ссылка, Сообщение)

	Попытка

		Тело = Новый Структура;
		Тело.Вставить("source_id", SourceId);
		Тело.Вставить("status", Статус);      // accepted | posted | rejected | error
		Тело.Вставить("ref", Ссылка);
		Тело.Вставить("message", Сообщение);

		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, Тело);

		Соединение = Новый HTTPСоединение(Константы.DocFlowХост.Получить(), 443, , , , 30,
			Новый ЗащищенноеСоединениеOpenSSL);

		Запрос = Новый HTTPЗапрос("/api/onec/status");
		Запрос.Заголовки.Вставить("Content-Type", "application/json");
		Запрос.Заголовки.Вставить("X-DocFlow-Token", Константы.DocFlowТокен.Получить());
		Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);

		Соединение.ОтправитьДляОбработки(Запрос);

	Исключение
		// Обрыв связи с DocFlow не должен откатывать уже загруженный документ.
		ЗаписьЖурналаРегистрации("DocFlow.Статус", УровеньЖурналаРегистрации.Предупреждение,
			, , ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
