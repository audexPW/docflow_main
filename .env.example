# ============================================================================
#  DocFlow — единый конфиг для всего стека (БД + бэкенд + фронт).
#  deploy.sh при первом запуске скопирует этот файл в .env и подставит секреты.
#  Здесь ничего заполнять руками не нужно, но при желании — можно.
# ============================================================================

# --- Публикация фронта ---
# На каком порту хоста будет доступен веб-интерфейс (и /api через nginx).
HTTP_PORT=80

# --- Приложение ---
APP_ENV=production
HTTP_ADDR=:8080
CORS_ORIGINS=*
MAX_UPLOAD_BYTES=26214400

# --- База данных ---
POSTGRES_USER=docflow
POSTGRES_PASSWORD=docflow
POSTGRES_DB=docflow
DATABASE_URL=postgres://docflow:docflow@postgres:5432/docflow?sslmode=disable

# --- Аутентификация ---
# Заполняется автоматически: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=12h

# Первичный администратор (создаётся только при пустой базе).
# Пароль заполнит deploy.sh и покажет в конце. Логин можно поменять.
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- Хранилище файлов ---
FILES_DIR=/var/lib/docflow/files
# Ключ шифрования файлов, ровно 32 байта в hex. Заполняется автоматически.
FILES_ENCRYPTION_KEY=

# --- OCR ---
# Движок распознавания:
#   tesseract — быстрый, лёгкий по CPU/RAM (по умолчанию), встроен в образ бэкенда;
#   paddle    — PaddleOCR, точнее на грязных сканах и фото: отдельный python-сервис
#               (профиль ai в compose), только CPU, секунды-десятки на страницу;
#   surya     — альтернативный тяжёлый движок (профиль ai-surya);
#   auto      — сначала tesseract, при слабом результате догоняет тяжёлый движок
#               (какой именно — OCR_AUTO_FALLBACK).
# Для paddle/surya/auto: COMPOSE_PROFILES=ai (см. ниже) и поднимите OCR_TIMEOUT.
OCR_ENGINE=paddle
OCR_AUTO_FALLBACK=surya
SURYA_URL=http://surya-ocr:8422
TESSERACT_BIN=tesseract
PDFTOPPM_BIN=pdftoppm
MAGICK_BIN=convert
OCR_LANGUAGES=rus+eng
OCR_DPI=300
# tesseract: 90s хватает. Для paddle/surya на CPU ставьте 600s.
OCR_TIMEOUT=600s

# --- Локальный AI-стек (paddle-ocr + llm), профиль compose "ai" ---
# ПУСТО = AI выключен, базовый стек лёгкий. Чтобы включить — ai:
#   COMPOSE_PROFILES=ai
# и выставьте OCR_ENGINE=paddle|auto и/или LLM_ENABLED=true.
# Для альтернативного движка Surya: COMPOSE_PROFILES=ai-surya + OCR_ENGINE=surya.
COMPOSE_PROFILES=ai

# Тюнинг paddle-ocr под железо (оставьте ядра под LLM/БД):
# Ограничение длинной стороны при детекции: меньше = быстрее и легче по RAM,
# но мелкий шрифт хуже. 960 — дефолт Paddle, 1600 — под сканы накладных.
# Классификатор поворота строк на 180° — нужен для фото с телефона.
# WARMUP=1 вшивает веса моделей в образ (офлайн). На офлайн-сборке — 0.

# Тюнинг surya-ocr (только если включён профиль ai-surya):
SURYA_THREADS=4
SURYA_REC_BATCH=16
SURYA_DET_BATCH=4
SURYA_ROW_TOL=12
# WARMUP=1 вшивает веса моделей в образ (офлайн). На офлайн-сборке — 0.
SURYA_WARMUP=1

# --- Локальная LLM (опционально) ---
# По умолчанию ВЫКЛЮЧЕНА, чтобы стек поднялся без модели и GPU.
# Распознавание работает на правилах + OCR. Чтобы включить:
#   1) COMPOSE_PROFILES=ai (см. выше) — поднимет сервис llm (llama.cpp);
#   2) положите .gguf в ./models и укажите имя в LLM_GGUF;
#   3) LLM_ENABLED=true.
LLM_ENABLED=true
LLM_BASE_URL=http://llm:8081/v1
LLM_MODEL=local
LLM_API_KEY=
LLM_TIMEOUT=60s
LLM_MAX_TOKENS=3072
LLM_TEMPERATURE=0.0
# Модель и параметры llama.cpp (сервис llm). Файл кладётся в ./models.
# Qwen2.5-7B-Instruct Q4_K_M (~4.7 ГБ весов + ~0.5 ГБ KV-кэша при ctx 4096).
# ВНИМАНИЕ: 7B + PaddleOCR + Postgres занимают ~8 ГБ. Минимум для хоста — 12 ГБ
# (столько на сервере заказчика). На 8 ГБ не помещаются.
# Более лёгкие варианты: qwen2.5-3b-instruct-q4_k_m.gguf (~2.3 ГБ, LLM_MEM_LIMIT=3g)
#                        qwen2.5-1.5b-instruct-q4_k_m.gguf (~1.1 ГБ, LLM_MEM_LIMIT=2g)
LLM_GGUF=qwen2.5-7b-instruct-q4_k_m.gguf
LLM_CTX=4096
LLM_THREADS=4

# --- Страновая специфика ---
# by — Беларусь: налоговый идентификатор УНП (9 цифр), выгрузка несёт <UNP>.
# ru — Россия: ИНН/КПП. Заказчик на «Моя бухгалтерия 8» (hs.by) — Беларусь.
LOCALE=by

# --- Типы документов и маршрутизация в 1С ---
# JSON-реестр: какие типы документов система знает, какие реквизиты для каждого
# обязательны и в какой объект базы 1С документ должен попасть.
# Пусто — встроенный набор без маппинга на 1С (тогда всё идёт через оператора).
# Файл монтируется в docker-compose.yml, заготовка — doctypes.example.json:
#   cp doctypes.example.json doctypes.json   и проставить реальные имена объектов
DOCTYPES_PATH=/etc/docflow/doctypes.json

# true  — в 1С автоматически уходят только типы с заданным onec.object;
#         остальные (в т.ч. новые, ранее не встречавшиеся) — оператору на проверку.
# false — отправлять любой опознанный тип, даже без согласованного приёмника.
#         Ставить только если приёмник в 1С сам разбирает вид документа по <Type>.
ONEC_REQUIRE_TYPE_MAPPING=true

# --- Интеграция с 1С ---
# Режимы: file (EnterpriseData XML в папку), rest (HTTP-сервис 1С), disabled
ONEC_MODE=file
ONEC_FILE_DIR=/var/lib/docflow/onec_outbox
ONEC_REST_URL=
ONEC_AUTH_HEADER=
ONEC_TIMEOUT=30s
ONEC_MAX_ATTEMPTS=8

# --- Автоматическая выгрузка в 1С ---
# true  — полностью распознанные документы уходят в 1С автоматически; при неполном
#         распознавании распознанное отправляется сразу, а недостающие поля клиент
#         вводит вручную, и они дошлются к тому же документу (1С сопоставляет по id).
# false — прежнее поведение: всё уходит на проверку оператору перед выгрузкой.
AUTO_EXPORT_ENABLED=true

# --- Серверные push-уведомления (FCM для Android, APNs для iOS) ---
# Выключено по умолчанию: без ключей провайдеров стек поднимается, а мобильное
# приложение показывает локальные уведомления по опросу статуса.
# Чтобы включить — PUSH_ENABLED=true и заполнить ключи ниже (см. MOBILE.md).
PUSH_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=by.docflow.app
APNS_PRODUCTION=true

# --- Воркеры ---
RECOGNIZE_WORKERS=2
EXPORT_WORKERS=1

# --- Адрес сайта и HTTPS -----------------------------------------------------
# DOMAIN задаётся при первом ./deploy.sh. Если он заполнен, поднимается Caddy,
# который сам получает и продлевает сертификат Let's Encrypt.
# Пусто = только HTTP (стенд), APP_ENV должен остаться development.
DOMAIN=
ACME_EMAIL=
PUBLIC_BASE_URL=

# --- Обратная связь из 1С (ТЗ §2, §10) ---------------------------------------
# Токен, которым 1С аутентифицируется, сообщая статус обработки документа:
#   POST /api/onec/status   заголовок X-DocFlow-Token: <значение>
# Генерируется автоматически при первом ./deploy.sh. В production пустым быть
# не может — сервис не поднимется.
ONEC_INBOUND_TOKEN=

# Через сколько дней убирать выгруженные XML в архив (0 — не трогать).
ONEC_OUTBOX_KEEP_DAYS=14
# Если 1С не подтвердила обработку за это время — предупреждение в лог.
ONEC_ACK_TIMEOUT=6h

# --- Лимиты памяти контейнеров ----------------------------------------------
# Рассчитаны на хост с 12 ГБ (Paddle + 7B ≈ 8 ГБ, остальное системе под кэш).
SURYA_MEM_LIMIT=4g
# 6g под 7B Q4 с ctx 4096. Для 3B — 3g, для 1.5B — 2g.
LLM_MEM_LIMIT=6g
