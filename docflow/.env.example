# --- Приложение ---
APP_ENV=production
HTTP_ADDR=:8080
CORS_ORIGINS=*
MAX_UPLOAD_BYTES=26214400

# --- База данных ---
DATABASE_URL=postgres://docflow:docflow@postgres:5432/docflow?sslmode=disable

# --- Аутентификация ---
# Произвольная длинная строка. Сгенерировать: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=12h

# Первичный администратор создаётся только при пустой базе.
# Если пароль не задан — он будет сгенерирован и один раз выведен в лог.
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- Хранилище файлов ---
FILES_DIR=/var/lib/docflow/files
# Ключ шифрования файлов, ровно 32 байта в hex. Сгенерировать: openssl rand -hex 32
FILES_ENCRYPTION_KEY=

# --- OCR (локальные бинарники) ---
TESSERACT_BIN=tesseract
PDFTOPPM_BIN=pdftoppm
MAGICK_BIN=convert
OCR_LANGUAGES=rus+eng
OCR_DPI=300
OCR_TIMEOUT=90s

# --- Локальная LLM (llama.cpp / любой OpenAI-совместимый сервер) ---
# Используется только для сложных случаев, когда правил недостаточно.
LLM_ENABLED=true
LLM_BASE_URL=http://llm:8081/v1
LLM_MODEL=local
LLM_API_KEY=
LLM_TIMEOUT=60s
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0

# --- Интеграция с 1С ---
# Режимы: file (EnterpriseData XML в папку), rest (HTTP-сервис 1С), disabled
# Страновая специфика: by (Беларусь, УНП) | ru (Россия, ИНН)
LOCALE=by

ONEC_MODE=file
ONEC_FILE_DIR=/var/lib/docflow/onec_outbox
ONEC_REST_URL=
ONEC_AUTH_HEADER=
ONEC_TIMEOUT=30s
ONEC_MAX_ATTEMPTS=8

# --- Воркеры ---
RECOGNIZE_WORKERS=2
EXPORT_WORKERS=1

# --- Автоматическая выгрузка в 1С ---
# true  — полностью распознанные документы уходят в 1С автоматически; при неполном
#         распознавании распознанное отправляется сразу, а недостающие поля клиент
#         вводит вручную, и они дошлются к тому же документу.
# false — прежнее поведение: всё уходит на проверку оператору перед выгрузкой.
AUTO_EXPORT_ENABLED=true

# --- Серверные push-уведомления (FCM для Android, APNs для iOS) ---
# Выключено по умолчанию. Если выключено, мобильное приложение показывает
# локальные уведомления по опросу статуса (push при этом не требуется).
PUSH_ENABLED=false
# FCM (Android): ID проекта Firebase и путь к JSON сервис-аккаунта.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
# APNs (iOS): ключ .p8 (token-based auth), его Key ID, Team ID и bundle id приложения.
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=ru.docflow.app
APNS_PRODUCTION=true
