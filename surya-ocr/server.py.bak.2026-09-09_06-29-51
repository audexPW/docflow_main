def _dbg(*a, **kw):
    # Вызовы перенесены из print и несут flush=True — принимаем любые
    # именованные аргументы и передаём их дальше, чтобы не править места вызова.
    if _DEBUG:
        kw.setdefault("flush", True)
        print(*a, **kw)

_state = {"ready": False, "error": None}
_lock = threading.Lock()
_models = {}


def _load_models():
    import torch
    from surya.foundation import FoundationPredictor
    from surya.recognition import RecognitionPredictor
    from surya.detection import DetectionPredictor

    if _THREADS:
        try:
            torch.set_num_threads(int(_THREADS))
        except Exception:
            pass

    foundation = FoundationPredictor()
    _models["foundation"] = foundation
    _models["recognition"] = RecognitionPredictor(foundation)
    _models["detection"] = DetectionPredictor()

    # Отсутствие детектора таблиц — не повод ронять весь OCR: распознавание
    # текста важнее, а таблица в худшем случае соберётся прежним способом.
    if _TABLE_REC:
        try:
            from surya.table_rec import TableRecPredictor

            _models["table_rec"] = TableRecPredictor()
        except Exception as exc:  # noqa: BLE001
            _state["table_rec_error"] = str(exc)

        # Layout нужен, чтобы найти на странице саму таблицу: детектор ячеек
        # работает по одной таблице, а не по листу целиком.
        # Сигнатура LayoutPredictor разошлась между версиями surya: где-то он
        # строится поверх foundation-модели, где-то создаётся сам. Пробуем оба
        # варианта, чтобы патч не привязывался к конкретной версии пакета.
        try:
            from surya.layout import LayoutPredictor

            try:
                _models["layout"] = LayoutPredictor(foundation)
            except TypeError:
                _models["layout"] = LayoutPredictor()
        except Exception as exc:  # noqa: BLE001
            _state["layout_error"] = str(exc)


@asynccontextmanager
async def lifespan(_: FastAPI):
    try:
        _load_models()
        _state["ready"] = True
    except Exception as exc:
        _state["error"] = str(exc)
    yield


